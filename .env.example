# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram id (узнать у @userinfobot); можно несколько через запятую
ADMIN_IDS=

# Оплата картой: токен провайдера из @BotFather → Payments. Пусто — только оплата при получении
PAYMENT_PROVIDER_TOKEN=
CURRENCY=RUB

DATABASE_URL=sqlite:///./shop.db
SHOP_NAME=Обжарка «Зерно»

# Доставка в копейках: 30000 = 300 ₽, бесплатно от 300000 = 3 000 ₽
DELIVERY_PRICE=30000
FREE_DELIVERY_FROM=300000
PICKUP_ADDRESS=Москва, ул. Примерная, 1 (ежедневно 10:00–21:00)
